# ============================================================
#  JNEET+ AI — .env.example
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ============================================================

# ── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB Atlas ─────────────────────────────────────────────
# Get this from: Atlas Dashboard → Connect → Drivers → Node.js
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/jneet_ai?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────
# Must be at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_minimum_32_character_random_string_here
JWT_EXPIRES_IN=7d

# ── Cookie Signing ────────────────────────────────────────────
# Must be at least 32 random characters. Can be same as JWT_SECRET
# or a different value — separate secrets are more secure.
COOKIE_SECRET=replace_with_a_different_minimum_32_character_random_string

# ── Email (Brevo HTTPS API — Render blocks SMTP) ──────────────
# Brevo → SMTP & API → API keys. EMAIL_FROM must be a VERIFIED sender
# (ideally on your own domain with SPF + DKIM set up in Brevo).
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=no-reply@yourdomain.com
EMAIL_FROM_NAME=JNEET+ AI

# ── AI (OpenAI Responses API) ─────────────────────────────────
OPENAI_API_KEY=your_openai_api_key
# Model per plan — change models here, no code change needed.
# Confirm the exact IDs in your OpenAI dashboard / GET /v1/models.
AI_MODEL_FREE=gpt-6-luna
AI_MODEL_PRO=gpt-6-luna
AI_MODEL_ELITE=gpt-6-luna
AI_MODEL_DEEP=gpt-6.1-sol
AI_MODEL_FALLBACK=gpt-6.1-sol
AI_MODEL_TITLE=gpt-6-luna
AI_DAILY_FREE=5
AI_DAILY_PRO=30
AI_DAILY_ELITE=50
AI_DEEP_MONTHLY_ELITE=10
# Circuit breaker: stop answering new questions for the day above this spend (INR)
# AI_DAILY_BUDGET_INR=500

# ── Cookies ───────────────────────────────────────────────────
# Once the API is on api.yourdomain.com (same site as the frontend) use "lax".
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.yourdomain.com

# ── Frontend URL (optional in dev, required in production) ────
# Used for CORS allowlist. In production, set to your deployed frontend URL.
# Comma-separated list of allowed frontend origins; the first is used in email links.
# FRONTEND_URL=https://www.yourdomain.com

# Optional target exam controls
RE_NEET_ACTIVE=false
# RE_NEET_DATE=2026-07-01T03:30:00.000Z

# Cloudflare Turnstile secret (captcha). Leave empty to keep the captcha off.
TURNSTILE_SECRET_KEY=
